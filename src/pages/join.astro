---
// Stand-alone signup page. One job: get someone onto the list. Built to be
// dropped into a LinkedIn post (or anywhere) as a soft call to action, so it
// stays off the primary nav and leads straight with the form.
//
// Reuses the shared <Signup> component, which POSTs { email, campaign } to
// /api/subscribe and talks to Beehiiv server-side. campaign="join" so the list
// shows which signups came from this page.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Panel from '../components/Panel.astro';
import Signup from '../components/Signup.astro';
---

<Base
  title="Join the list · J Scott Chapman"
  description="The occasional note on building AI products, shipping them, and finding out whether they actually worked. No fixed schedule, no spam, no selling your address."
  ogImage="/og-join-lattice.png"
>
  <PageHead
    title="One email, now and then."
    deck="I build AI products end to end, then write up what actually worked. Drop your email and the next one lands in your inbox. Nothing else."
  >
    <Signup campaign="join" button="Sign me up" bare />
  </PageHead>

  <Panel title="What lands in your inbox" id="inbox-h">
    <div class="points">
      <div class="point">
        <b>Field notes, not announcements.</b>
        <span>What I built, what broke, and whether it actually moved the number.</span>
      </div>
      <div class="point">
        <b>The occasional free tool.</b>
        <span>Claude skills and small utilities, the moment they're worth sharing.</span>
      </div>
      <div class="point">
        <b>No fixed schedule.</b>
        <span>A note when there's something worth sending. Never to fill a calendar slot.</span>
      </div>
    </div>
  </Panel>
</Base>
