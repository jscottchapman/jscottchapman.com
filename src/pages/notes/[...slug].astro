---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Share from '../../components/Share.astro';
import Signup from '../../components/Signup.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title={`${entry.data.title} · J Scott Chapman`}
  description={entry.data.description}
>
  <PageHead title={entry.data.title} deck={entry.data.description} aside={fmt(entry.data.date)}>
    <div class="actions">
      <a class="btn" href="/notes/"><span class="tx">All notes</span></a>
    </div>
  </PageHead>

  <article class="wrap article">
    <aside class="article-aside">
      <div class="sticky">
        <Share title={entry.data.title} />
      </div>
    </aside>
    <div class="article-body prose">
      <Content />
    </div>
  </article>

  <section class="wrap sec">
    <Signup
      campaign={`note:${entry.id}`}
      heading="Want the next note in your inbox?"
      body="I write these when there's something worth saying, not on a schedule. Drop your email and I'll send the next one along. Nothing else."
    />
  </section>
</Base>
