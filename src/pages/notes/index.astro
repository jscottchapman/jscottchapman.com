---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Signup from '../../components/Signup.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const dayYear = (d: Date) => `${d.getUTCDate()}, ${d.getUTCFullYear()}`;
---

<Base
  title="Notes · J Scott Chapman"
  description="Short pieces on building software, shipping it, and the AI tooling I'm actually using."
>
  <PageHead
    title="Notes."
    deck="Building, shipping, and the AI tools I'm actually putting into production, not the demo version."
    aside="Written when there's something to say, not on a schedule."
  />

  <section class="wrap sec" aria-label="All notes">
    {notes.length === 0 ? (
      <p class="empty">Nothing published yet. Soon.</p>
    ) : (
      <div class="note-list">
        {notes.map((n) => (
          <a class="note-row" href={`/notes/${n.id}/`}>
            <time class="note-date" datetime={n.data.date.toISOString().slice(0, 10)}><strong>{month(n.data.date)}</strong><span class="num">{dayYear(n.data.date)}</span></time>
            <div class="note-body"><h2 class="note-title">{n.data.title}</h2><p>{n.data.description}</p></div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="wrap sec">
    <Signup
      campaign="notes-index"
      heading="Want these in your inbox?"
      body="I write these when there's something worth saying, not on a schedule. Drop your email and the next note comes to you. Nothing else."
    />
  </section>
</Base>
