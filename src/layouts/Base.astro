---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** og image path under the site root, e.g. "/og.png" */
  ogImage?: string;
}

const {
  title = 'J Scott Chapman · AI product consultant',
  description = 'J Scott Chapman is an AI product consultant who builds software end to end, stays close to the people using it, and finds out whether it actually worked.',
  ogImage = '/og-home-lattice.png',
} = Astro.props;

// On preview deploys, point canonical + OG image at the deployment's own
// domain so share cards are self-contained. Production uses the real site.
const prodOrigin = 'https://jscottchapman.com';
const deployOrigin =
  process.env.VERCEL_ENV && process.env.VERCEL_ENV !== 'production' && process.env.VERCEL_URL
    ? `https://${process.env.VERCEL_URL}`
    : prodOrigin;
const canonical = new URL(Astro.url.pathname, deployOrigin);
const ogImageUrl = new URL(ogImage, deployOrigin);
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/notes/', label: 'Notes' },
  { href: '/skills/', label: 'Skills' },
  { href: '/about/', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F4F1" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="J Scott Chapman" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@RavenviewSrvcs" />
    <meta name="twitter:creator" content="@RavenviewSrvcs" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Marcellus+SC&family=Jost:ital,wght@0,300..600;1,400&family=Red+Hat+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics (GA4) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-8XPSMSKQG8"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-8XPSMSKQG8');
    </script>

    <slot name="head" />
  </head>
  <body>
    <!-- The one glyph the site draws: four squares, used on every square-cell control. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="g4" viewBox="0 0 16 16"><rect x="1" y="1" width="6" height="6" fill="currentColor"/><rect x="9" y="1" width="6" height="6" fill="currentColor"/><rect x="1" y="9" width="6" height="6" fill="currentColor"/><rect x="9" y="9" width="6" height="6" fill="currentColor"/></symbol>
    </svg>

    <div class="wrap">
      <header class="mast">
        <a class="brand" href="/" aria-label="J Scott Chapman, home">
          <svg viewBox="0 0 42 42" aria-hidden="true">
            <rect x=".75" y=".75" width="40.5" height="40.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <g fill="currentColor">
              <rect x="5" y="5" width="4" height="4"/><rect x="12" y="5" width="4" height="4"/><rect x="19" y="5" width="4" height="4"/><rect x="26" y="5" width="4" height="4"/><rect x="33" y="5" width="4" height="4"/>
              <rect x="5" y="33" width="4" height="4"/><rect x="12" y="33" width="4" height="4"/><rect x="19" y="33" width="4" height="4"/><rect x="26" y="33" width="4" height="4"/><rect x="33" y="33" width="4" height="4"/>
              <rect x="5" y="12" width="4" height="4"/><rect x="5" y="19" width="4" height="4"/><rect x="5" y="26" width="4" height="4"/>
              <rect x="33" y="12" width="4" height="4"/><rect x="33" y="19" width="4" height="4"/><rect x="33" y="26" width="4" height="4"/>
              <rect x="13" y="13" width="7" height="7"/><rect x="22" y="13" width="7" height="7"/><rect x="13" y="22" width="7" height="7"/><rect x="22" y="22" width="7" height="7"/>
            </g>
          </svg>
          <span><span class="brand-name">J Scott Chapman</span><span class="brand-place">Missoula, Montana</span></span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </header>
      <div class="pierce band-gap" aria-hidden="true"></div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot wrap">
      <div class="pierce" aria-hidden="true"></div>
      <div class="row">
        <span>© 2026 J Scott Chapman · Missoula, Montana</span>
        <nav aria-label="Footer">
          <a href="/work/">Work</a>
          <a href="/notes/">Notes</a>
          <a href="/skills/">Skills</a>
          <a href="mailto:scott@ravenviewservices.com">Email</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
